# Copy this file to `.env` (same folder) and fill in your own keys.
# `.env` is gitignored (.gitignore line 39) and must never be committed.
# If a key is ever exposed, REVOKE it in the provider console -- deleting the
# file does not remove anything git has already recorded.

# Groq -- the primary generator (pipeline SS4.4). console.groq.com -> API Keys.
GROQ_API_KEY=gsk_replace_me

# Gemini -- secondary, on a subset only (pipeline SS4.4).
# aistudio.google.com -> Get API key. Optional until the subset cross-check runs.
GOOGLE_API_KEY=replace_me

# --- Alternatives tried while looking for enough free capacity (2026-08-12) ---
# All are OpenAI-compatible, so only the key and the base URL differ.
# Run: python src/agents/provider_preflight.py --provider <name>
# to see what each account ACTUALLY serves and what its real limits are.
MISTRAL_API_KEY=replace_me      # console.mistral.ai -- phone verification; free
                                # tier requires opting IN to data training, which
                                # is a disclosure item for the thesis, not a
                                # blocker: the corpus is already public (Mendeley)
NVIDIA_API_KEY=replace_me       # build.nvidia.com -- credit-based
CEREBRAS_API_KEY=replace_me     # cloud.cerebras.ai -- $5 trial credits
