# --- Raw data is immutable and NOT versioned here (size + license) ---
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Derived data: cleaned CSVs are reproducible from raw + config -> not committed
data/cleaned/*
!data/cleaned/.gitkeep

# !!! EXCEPTION: plot synopses ARE committed. They are hand-collected primary
# data -- no script can regenerate them, and re-collecting means re-reading the
# sources by hand. They are also the only held-out element of the evaluation, so
# losing them invalidates S6. Treat them like the split map, not like a cache.
!data/plots/
!data/plots/*.csv

# !!! EXCEPTION: split map IS committed. It is the single most important
# artifact of the thesis (see pipeline section A). Never gitignore it.
!data/splits/
!data/splits/*.json

# Env / caches
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
wandb/
*.pt
*.bin
.DS_Store

# Unzipped Kaggle output bundles -- transient, the files inside are what matter
zip/
*.zip

# Raw harvest -- regenerable by re-running plots_scrape.py; only the sampled
# 130 in plots_bn.csv are committed.
data/plots/plots_bn_harvest.csv
data/plots/.harvest_state.json
data/plots/review.html
