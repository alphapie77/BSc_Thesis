@article{mattei2026welltempered,
  title   = {The Well-Tempered Classifier: Some Elementary Properties of
             Temperature Scaling},
  author  = {Mattei, Pierre-Alexandre and Loureiro, Bruno},
  journal = {arXiv preprint arXiv:2602.14862},
  year    = {2026},
  note    = {Inria / ENS-PSL. Read in full 2026-08-11 via alphaXiv.
             SETTLES OPEN DECISION 17. Because the inverse temperature beta>0,
             "the coefficients of beta*z are ordered in the same way as those
             of z", so temperature scaling is ACCURACY-PRESERVING -- it cannot
             change the ordering, therefore cannot change which items fall
             either side of ANY threshold. Their Theorem 5.1 / Corollary 1
             strengthen this to a characterisation: temperature scaling is the
             ONLY accuracy-preserving linear scaler, which is why matrix
             scaling and Dirichlet calibration can move hard predictions and
             it cannot. CONSEQUENCE FOR US: "calibrated or uncalibrated tau"
             is not a choice about information -- every tau on the calibrated
             scale maps to exactly one tau on the raw scale with an identical
             PASS/FAIL partition. Confirmed on our own dev-82: 0 rank
             inversions, 1 new tie, 2 items saturated to exactly 1.0.}
}

