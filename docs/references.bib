% ⚠️ FOUND 2026-08-08 WHILE VERIFYING gwet2008ac1, AND IT CORRECTS US.
% This paper shows AC1 is NOT a drop-in replacement for kappa: for a fixed
% agreement rate, AC1 *increases* as the prevalence of one category departs from
% 0.5 -- which is exactly the G-300 round-1 situation (68--76% of ratings were
% the single value "2"). So our AC1 = 0.871 is partly a mechanical consequence
% of the skew, not independent evidence of rater agreement. It must never be
% quoted without this caveat, and Landis & Koch's verbal bands must NOT be
% applied to it. See docs/lab_notebook.md, entry of 2026-08-08.
@article{vach2023ac1,
  title   = {Gwet's {AC1} Is Not a Substitute for {Cohen's} Kappa --
             A Comparison of Basic Properties},
  author  = {Vach, Werner and Gerke, Oke},
  journal = {MethodsX},
  year    = {2023},
  note    = {Verified via Consensus 2026-08-08 (74 citations).}
}

