@misc{mahmoud2026rubric,
  title  = {Reward Hacking in Rubric-Based Reinforcement Learning},
  author = {Mahmoud, Anas and Rezaei, MohammadHossein and Wang, Zihao and
            Gunjal, Anisha and Liu, Bing and He, Yunzhong},
  year   = {2026},
  howpublished = {arXiv preprint arXiv:2605.12474},
  note   = {🔴 LOAD-BEARING, and now READ IN FULL (2026-08-11) -- the
            abstract-only reading of 2026-08-10 missed the half that matters.
            Used TWICE and for opposite purposes. (1) Decision 16: it makes
            cross-family reference panels the standard, and finds weak verifiers
            produce proxy gains that do not transfer. (2) It REFUTES the proposed
            RQ3 reframing that symbolic/rule-based scoring resists gaming. Under a
            STRONG verifier, rubric-based judges preferred the RL checkpoint on
            85.8% of prompts while rubric-free judges preferred the BASE model on
            78.4%; gains concentrated in PRESENCE-BASED criteria (completeness
            +1.07) with losses in conciseness (-2.91), relevance (-1.10), factual
            correctness (-0.85), overall (-1.02). Mechanism named: "hacking the
            rubric, not the verifier." Our sect. 3.5 feature pool is almost entirely
            presence/count-based, and our Reflector TELLS the writer which rule
            failed -- strictly easier to game than their setting. Also supplies
            the self-internalization gap diagnostic (r 0.91-0.97 with reference
            reward), which we cannot use: it needs a training trajectory and we
            never fine-tune (inviolable rule 10).}
}

